# MeshCentral connection
MESH_SERVER_URL=https://your-meshcentral-server.com

# Authentication - use EITHER a login token (preferred) or a username/password.
#
# Login token (preferred): create one in the MeshCentral web UI under
# "My Account" > "Login tokens". MeshCentral returns a PAIR - a token username
# (always prefixed "~t:") and a token password. Both are required; the password
# on its own cannot authenticate. Tokens can be given an expiry and revoked
# without changing the account password.
# MESH_TOKEN_USER=~t:xxxxxxxxxxxxxxxx
# MESH_TOKEN_PASS=xxxxxxxxxxxxxxxxxxxx
#
# Or supply both in one variable as "tokenUser,tokenPass":
# MESH_TOKEN=~t:xxxxxxxxxxxxxxxx,xxxxxxxxxxxxxxxxxxxx

# Username/password fallback
MESH_USERNAME=your-username
MESH_PASSWORD=your-password

# Optional: Domain (leave empty for default)
# MESH_DOMAIN=

# Optional: Skip TLS verification (for self-signed certs)
# MESH_INSECURE_TLS=false

# Local file access for mesh_file_download / mesh_file_upload.
# These two tools are the only ones that touch this machine's own disk. They are
# confined to the directory below, which is created on startup (default:
# ./mcp-files, relative to the server's working directory).
# Setting this to * disables the restriction and lets the agent read and write
# anywhere this process can - including this .env file. Not recommended.
# MESH_LOCAL_FILE_ROOT=./mcp-files
